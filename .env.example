# ============================================================================
# ArkAngel Frontend Environment Variables
# ============================================================================

# Supabase Configuration
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://oyexmxetjudbnuhairry.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Configuration (Live Production Keys)
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Price IDs
VITE_STRIPE_PRICE_PREMIUM=your_premium_price_id_here
VITE_STRIPE_PRICE_MAX=your_max_price_id_here

# Composio Feature Flag (Optional)
# -----------------------------------------------------------------------------
# Enable Composio integrations in frontend (true/false)
# Can also be toggled via localStorage: localStorage.setItem('use_composio', 'true')
VITE_USE_COMPOSIO=false

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env.local in the same directory:
#    cp .env.example .env.local
#
# 2. Fill in your Supabase credentials
# 3. Fill in your Stripe credentials (if using payments)
# 4. To enable Composio, set VITE_USE_COMPOSIO=true
#
# Note: .env.local is gitignored and will not be committed
#
# ============================================================================

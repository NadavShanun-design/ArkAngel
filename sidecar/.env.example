# ============================================================================
# ArkAngel Sidecar Environment Variables
# ============================================================================

# Server Configuration
# -----------------------------------------------------------------------------
AGENT_PORT=8765
PORT=8765

# Composio API Configuration
# -----------------------------------------------------------------------------
# Get your API key from https://app.composio.dev/
# Sign up for free to access 250+ integrations
COMPOSIO_API_KEY=your_composio_api_key_here

# Feature Flags
# -----------------------------------------------------------------------------
# Enable Composio for intelligent tool integration (true/false)
USE_COMPOSIO=false

# Fall back to MCP-use if Composio fails (true/false)
COMPOSIO_FALLBACK=true

# Enable verbose logging for Composio operations (true/false)
COMPOSIO_DEBUG=false

# OpenAI Configuration (for agent LLM)
# -----------------------------------------------------------------------------
# OpenAI API key for powering the intelligent agent
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Configuration (for Google Workspace MCP - legacy)
# -----------------------------------------------------------------------------
# These are used by the legacy MCP-use Google Workspace integration
# Get from https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_MCP_CREDENTIALS_DIR=~/.google_workspace_mcp/credentials

# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG

# Development Only - Allow OAuth over HTTP (DO NOT USE IN PRODUCTION)
# -----------------------------------------------------------------------------
OAUTHLIB_INSECURE_TRANSPORT=0

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env in the same directory:
#    cp .env.example .env
#
# 2. Get your Composio API key:
#    - Visit https://app.composio.dev/
#    - Sign up (free tier available)
#    - Navigate to Settings -> API Keys
#    - Copy your API key and paste it above
#
# 3. Get your OpenAI API key:
#    - Visit https://platform.openai.com/api-keys
#    - Create a new API key
#    - Copy and paste it above
#
# 4. Enable Composio:
#    - Set USE_COMPOSIO=true
#
# 5. Restart the sidecar:
#    cd sidecar
#    npm run build
#    npm start
#
# ============================================================================
